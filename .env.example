# HubSpot private-app access token used by `npm run fetch`.
# Create a private app in HubSpot (Settings > Integrations > Private Apps) with the
# scopes: automation (read) and crm.schemas.contacts.read (for property metadata).
HUBSPOT_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: HubSpot API base. Defaults to https://api.hubapi.com
# HUBSPOT_API_BASE=https://api.hubapi.com

# Claude API key for the "Ask AI" chat (server-side only — never exposed to the browser).
# Get one at https://console.anthropic.com. Required to run the chat.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model for the chat. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

# Optional: port the Express server listens on. Defaults to 8080.
# PORT=8080

# ---------------------------------------------------------------------------
# Portal mode (multi-portal + HubSpot OAuth login). Set ALL of these to enable;
# leave them unset to run in standalone mode (single HUBSPOT_TOKEN above).
# ---------------------------------------------------------------------------

# Encryption key for HubSpot tokens at rest + signed session cookies (long random).
# APP_SECRET=change-me-to-a-long-random-string

# Postgres connection string (managed DB in production).
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# HubSpot public app OAuth credentials (Developer account → Apps → Auth tab).
# HUBSPOT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# HUBSPOT_CLIENT_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Must match a redirect URL on the HubSpot app and point at this server:
# HUBSPOT_REDIRECT_URI=http://localhost:8080/auth/hubspot/callback

# Optional: OAuth scopes to request (defaults shown).
# HUBSPOT_SCOPES=oauth automation crm.objects.deals.read crm.objects.tickets.read

# Optional: beta flows detail API version, and enrichment toggle (1=on default).
# HUBSPOT_FLOWS_VERSION=2026-09-beta
# HUBSPOT_ENRICH=1
