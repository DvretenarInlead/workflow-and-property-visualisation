# HubSpot private-app access token used by `npm run fetch`.
# Create a private app in HubSpot (Settings > Integrations > Private Apps) with the
# scopes: automation (read) and crm.schemas.contacts.read (for property metadata).
HUBSPOT_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: HubSpot API base. Defaults to https://api.hubapi.com
# HUBSPOT_API_BASE=https://api.hubapi.com

# Claude API key for the "Ask AI" chat (server-side only — never exposed to the browser).
# Get one at https://console.anthropic.com. Required to run the chat.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: model for the chat. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

# Optional: port the Express server listens on. Defaults to 8080.
# PORT=8080
